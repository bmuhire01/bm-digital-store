{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/(.*)\\.php", "dest": "/api/index.php?page=$1" },
    { "src": "/", "dest": "/api/index.php?page=index" },
    { "src": "/admin", "dest": "/api/index.php?page=admin/index" }
  ]
}
